{
  "manifest_version": 3,
  "name": "Smartech Event Validator",
  "version": "0.0.0",
  "description": "Validates Smartech analytics events against an uploaded Event Sheet.",
  "minimum_chrome_version": "120",
  "devtools_page": "devtools/devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/debug-capture.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
